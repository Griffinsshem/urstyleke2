# Where the Next.js server forwards /api/* to. Server-side only; never exposed to the browser.
# Local development: the Flask dev server (this is also the default if unset).
# On Vercel it must be set, for example https://your-api.onrender.com (no trailing slash).
BACKEND_ORIGIN=http://127.0.0.1:5000

# Shared secret that src/proxy.js sends to the API as X-Origin-Secret, so the API can
# tell requests that came through this app from direct calls. Must equal ORIGIN_SECRET
# on the API (at least 32 random characters). Required on Vercel production. Leave
# unset locally: the proxy then forwards without it.
ORIGIN_SECRET=
