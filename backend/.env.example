# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env.
#
# Required: SECRET_KEY, JWT_SECRET_KEY and DATABASE_URL (the app refuses to
# start without them). Everything else is optional; optional lines are commented
# out and show their default.

# ---- Required ---------------------------------------------------------------
# Generate each secret with:
#   python3.12 -c "import secrets; print(secrets.token_hex(32))"
# Use a different value for each, at least 32 characters.
SECRET_KEY=
JWT_SECRET_KEY=

# Neon PostgreSQL. Use the DIRECT connection string for migrations and the
# POOLED one (hostname contains -pooler) for the running app.
# Example shape:
#   postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# ---- Tests only -------------------------------------------------------------
# Separate Neon branch used ONLY by automated tests (they erase its data).
# Must be different from DATABASE_URL. Never point this at production.
TEST_DATABASE_URL=

# ---- Sessions ---------------------------------------------------------------
# Session cookies are Secure (HTTPS only) by default. Set to false ONLY to try
# cookies over plain http on your own machine; never in production.
# AUTH_COOKIE_SECURE=true

# ---- Reverse proxies (production) -------------------------------------------
# How many proxies in front of the API append to X-Forwarded-For, so the real
# visitor address is used for rate limiting. 0 trusts none (the local default).
# On Render a direct request carries 3 entries, so production uses 3.
# TRUSTED_PROXY_HOPS=0
#
# Origin lock. The website's Next.js proxy sends this secret as X-Origin-Secret,
# which lets the API tell requests that came through the website from direct
# calls. Use the same value as ORIGIN_SECRET on Vercel. At least 32 characters;
# generate it like the secrets above and never commit it.
# ORIGIN_SECRET=
# Hops to trust for requests that carry the correct secret (the website adds
# one more entry, so production uses 4). Needs ORIGIN_SECRET and must not be
# lower than TRUSTED_PROXY_HOPS. Defaults to TRUSTED_PROXY_HOPS.
# VERIFIED_PROXY_HOPS=4

# ---- CORS -------------------------------------------------------------------
# Off by default: the website calls /api on its own origin through the Next.js
# proxy. Set only if a browser app on another origin must call the API directly.
# Comma-separated exact origins (https, or http for localhost); no wildcards.
# CORS_ORIGINS=https://shop.example,http://localhost:3000

# ---- Rate limits ------------------------------------------------------------
# Counted in memory per process (one Gunicorn worker), so they reset on restart.
# RATELIMIT_ENABLED=true
# RATELIMIT_LOGIN_IP=20 per minute;100 per hour
# RATELIMIT_REGISTER_IP=10 per hour
# RATELIMIT_ORDERS_USER=30 per minute
# RATELIMIT_REFRESH_IP=60 per minute;600 per hour
# RATELIMIT_LOGIN_FAILS=8 per 15 minutes

# ---- Logging ----------------------------------------------------------------
# LOG_LEVEL=INFO
