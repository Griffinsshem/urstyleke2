# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env.

# Flask environment: development or production
FLASK_ENV=development

# Generate each secret with:
#   python3.12 -c "import secrets; print(secrets.token_hex(32))"
# Use a different value for each, at least 32 characters.
SECRET_KEY=
JWT_SECRET_KEY=

# Neon PostgreSQL. Use the DIRECT connection string for migrations and the
# POOLED one (hostname contains -pooler) for the running app.
# Example shape:
#   postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=
